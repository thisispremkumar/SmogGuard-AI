# SmogGuard AI Environment Configuration
PORT=3001
NODE_ENV=development

# Google Cloud Platform (GCP) Configuration
GCP_PROJECT_ID=promptwars-edition
GCP_PROJECT_NUMBER=730243407394
GCP_REGION=us-central1

# Optional: Google Gemini API Key for live LLM reasoning.
# If omitted or offline, SmogGuard AI automatically uses its built-in
# scientific expert reasoning engine calibrated to WHO & EPA air quality standards.
GEMINI_API_KEY=

# Optional: Allowed CORS origins (comma-separated). Defaults to * in development
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
